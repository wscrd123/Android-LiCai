<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：ScrollView 可上下滚动，里面用约束布局排列控件 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- ① 顶部：返回键 + 姓名学号（静态写死） -->
        <LinearLayout
            android:id="@+id/bar_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#0F766E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/btn_back_menu"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#FFFFFF"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="返回"
                android:textColor="#1565C0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_student"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="金融小助手(窦烁2406100206)"
                android:background="#0F766E "
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ② 大标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="理财收益计算器"
            android:textColor="#9D47A1"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bar_top" />

        <!-- ③ 输入行 1：本金 / 每月投入 -->
        <EditText
            android:id="@+id/et_money"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:hint="例如 10000"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/tv_label_money"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <TextView
            android:id="@+id/tv_label_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="本金/月投(元)"
            android:textColor="#212121"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/et_money"
            app:layout_constraintBottom_toBottomOf="@id/et_money" />

        <!-- ④ 输入行 2：年化收益率 -->
        <EditText
            android:id="@+id/et_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:hint="例如 3.5"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/tv_label_rate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_money" />

        <TextView
            android:id="@+id/tv_label_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="年化收益率(%)"
            android:textColor="#212121"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/et_rate"
            app:layout_constraintBottom_toBottomOf="@id/et_rate" />

        <!-- ⑤ 输入行 3：投资年限 -->
        <EditText
            android:id="@+id/et_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:hint="例如 3"
            android:inputType="number"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/tv_label_year"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_rate" />

        <TextView
            android:id="@+id/tv_label_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="投资年限(年)"
            android:textColor="#212121"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/et_year"
            app:layout_constraintBottom_toBottomOf="@id/et_year" />

        <!-- ⑥ 备选控件 1：RadioGroup 单选组（一组里只能选一个） -->
        <TextView
            android:id="@+id/tv_label_way"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:text="投资方式"
            android:textColor="#212121"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_year" />

        <RadioGroup
            android:id="@+id/rg_way"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_way">

            <RadioButton
                android:id="@+id/rb_once"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="一次性投入"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rb_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="每月定投"
                android:textSize="15sp" />
        </RadioGroup>

        <!-- ⑦ 备选控件 2：Spinner 下拉列表 -->
        <Spinner
            android:id="@+id/sp_risk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintStart_toEndOf="@id/tv_label_risk"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rg_way" />

        <TextView
            android:id="@+id/tv_label_risk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="风险等级"
            android:textColor="#212121"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/sp_risk"
            app:layout_constraintBottom_toBottomOf="@id/sp_risk" />

        <!-- ⑧ 备选控件 3：CheckBox 复选框 -->
        <CheckBox
            android:id="@+id/cb_compound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:checked="true"
            android:text="按复利计算（利滚利）"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sp_risk" />

        <!-- ⑨ 备选控件 4：ImageButton 图片按钮 -->
        <ImageButton
            android:id="@+id/btn_calc"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:background="#1D9478"
            android:contentDescription="开始计算"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cb_compound" />

        <TextView
            android:id="@+id/tv_hint_calc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="点上面的按钮开始计算"
            android:textColor="#757575"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_calc" />

        <!-- ⑩ 备选控件 5：GridView 网格（3 列 2 行） -->
        <TextView
            android:id="@+id/tv_label_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:text="热门理财产品（点一个试试）"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_hint_calc" />

        <GridView
            android:id="@+id/gv_product"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="14dp"
            android:horizontalSpacing="2dp"
            android:numColumns="3"
            android:verticalSpacing="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_grid" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>